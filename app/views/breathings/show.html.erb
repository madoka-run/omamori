<h1><%= @breathing[:name] %></h1>
<% total_seconds = (@breathing[:inhale] + @breathing[:hold] + @breathing[:exhale]) * @breathing[:cycles] %>
<% total_minutes = total_seconds / 60 %>

<p><%= total_minutes %>分間、落ち着く呼吸を行います</p>

<div class="flower-test" style="position: relative; width: 200px; height: 100px; margin: 100px auto;">
  <img src="<%= asset_path('petal.png') %>" style="position: absolute; top: 48px; left: 70px; width: 60px; transform-origin: 50% 88%; transform: rotate(0deg);">
  <img src="<%= asset_path('petal.png') %>" style="position: absolute; top: 48px; left: 70px; width: 60px; transform-origin: 50% 88%; transform: rotate(72deg);">
  <img src="<%= asset_path('petal.png') %>" style="position: absolute; top: 48px; left: 70px; width: 60px; transform-origin: 50% 88%; transform: rotate(144deg);">
  <img src="<%= asset_path('petal.png') %>" style="position: absolute; top: 48px; left: 70px; width: 60px; transform-origin: 50% 88%; transform: rotate(216deg);">
  <img src="<%= asset_path('petal.png') %>" style="position: absolute; top: 48px; left: 70px; width: 60px; transform-origin: 50% 88%; transform: rotate(288deg);">
</div>

<div data-controller="breathing"
     data-breathing-inhale-value="<%= @breathing[:inhale] %>"
     data-breathing-hold-value="<%= @breathing[:hold] %>"
     data-breathing-exhale-value="<%= @breathing[:exhale] %>"
     data-breathing-anxiety-log-id-value="<%= params[:anxiety_log_id] %>">
    <button data-action="click->breathing#start" data-breathing-target="startButton">始める</button>
    <p data-breathing-target="phase"></p>

    <div data-breathing-target="choices" hidden>
      <button data-action="click->breathing#restart">もう一度やる</button>
      <%= button_to "他の方法を試す", suggestions_anxiety_log_path(params[:anxiety_log_id]), method: :get %>
      <%= button_to "落ち着いた", anxiety_log_path(params[:anxiety_log_id]), method: :patch, params: { status: "resolved" } %>  
    </div>
</div>