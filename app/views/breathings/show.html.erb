

<h1><%= @breathing[:name] %></h1>
<% total_seconds = (@breathing[:inhale] + @breathing[:hold] + @breathing[:exhale]) * @breathing[:cycles] %>
<% total_minutes = total_seconds / 60 %>

<p><%= total_minutes %>分間、落ち着く呼吸を行います</p>

<div data-controller="elapsed-timer" data-elapsed-timer-started-at-value="<%= @anxiety_log.started_at.iso8601 %>">
  <p data-elapsed-timer-target="display">
    <span data-elapsed-timer-target="hoursWrapper" hidden><span data-elapsed-timer-target="hours"></span>時間</span><span data-elapsed-timer-target="minutes"></span>分<span data-elapsed-timer-target="seconds"></span>秒経過
  </p>
  <button data-action="click->elapsed-timer#toggle" class="text-link">⏰隠す/表示</button>
</div>


<div data-controller="breathing"
     data-breathing-inhale-value="<%= @breathing[:inhale] %>"
     data-breathing-hold-value="<%= @breathing[:hold] %>"
     data-breathing-exhale-value="<%= @breathing[:exhale] %>"
     data-breathing-anxiety-log-id-value="<%= params[:anxiety_log_id] %>">

    <div class="flower-test" style="position: relative; width: 200px; height: 100px; margin: 100px auto 0px;">
      <div style="position: absolute; top: -40px; left: 70px; width: 60px; transform-origin: 50% 88%; transform: rotate(0deg);">
        <img src="<%= asset_path('petal.png') %>" style="width: 100%; display: block;" data-breathing-target="leaf">
      </div>
      <div style="position: absolute; top: -40px; left: 70px; width: 60px; transform-origin: 50% 88%; transform: rotate(90deg);">
        <img src="<%= asset_path('petal.png') %>" style="width: 100%; display: block;" data-breathing-target="leaf">
      </div>
      <div style="position: absolute; top: -40px; left: 70px; width: 60px; transform-origin: 50% 88%; transform: rotate(180deg);">
        <img src="<%= asset_path('petal.png') %>" style="width: 100%; display: block;" data-breathing-target="leaf">
      </div>
      <div style="position: absolute; top: -40px; left: 70px; width: 60px; transform-origin: 50% 88%; transform: rotate(270deg);">
        <img src="<%= asset_path('petal.png') %>" style="width: 100%; display: block;" data-breathing-target="leaf">
      </div>
    </div>

    <button data-action="click->breathing#start" data-breathing-target="startButton">始める</button>
    <p data-breathing-target="phase"></p>

    <div data-breathing-target="choices" hidden>
      <button data-action="click->breathing#restart" class="choice-button">もう一度やる</button>
      <br>
      <%= link_to "他の方法を試す", suggestions_anxiety_log_path(params[:anxiety_log_id]), class: "choice-button" %>
      <%= button_to "落ち着いた", anxiety_log_path(params[:anxiety_log_id]), method: :patch, params: { status: "resolved" }, class: "choice-button" %>
    </div>
</div>


<div class="breathing-nav">
  <%= link_to "他の方法を試す", suggestions_anxiety_log_path(params[:anxiety_log_id]), class: "text-link" %>
  <%= button_to "記録を終了する", anxiety_log_path(@anxiety_log), method: :patch, params: { status: "resolved" }, data: { turbo_confirm: "本当に終了しますか？" }, class: "text-link" %>
  <%= button_to "今の記録をやめる", anxiety_log_path(@anxiety_log), method: :delete, params: { return_to: "top" }, data: { turbo_confirm: "今の記録を削除しますか？(元に戻せません)" }, class: "text-link" %>
</div>

