<h1>今日も不安は終わりました</h1>

<p>不安レベル: <%= @anxiety_log.anxiety_level %></p>
<p>時間: <%= @anxiety_log.duration_in_minutes %> 分</p>

<% unless user_signed_in? %>
    <p>このログを記録しますか？</p>
    <div>
        <%= link_to "新規会員登録", new_user_registration_path(anxiety_log_id: @anxiety_log.id) %>
        <br>
        <%= link_to "ログイン", new_user_session_path(anxiety_log_id: @anxiety_log.id) %>
    </div> 
<% end %>

<%= link_to "過去の記録を見る", anxiety_logs_path %>
<br>
<%= link_to "トップに戻る", root_path %>