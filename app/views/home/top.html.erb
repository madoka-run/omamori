<h1>omamori</h1>
<%= image_tag "omamoribag.png", class: "omamori-bag" %>

<p>不安が来ても、いつか終わります。</p>
<%= link_to "落ち着く呼吸法をはじめる", new_anxiety_log_path %>
<% if @active_anxiety_log %>
    <br>
    <%= link_to "他の方法を試す", suggestions_anxiety_log_path(@active_anxiety_log), class: "text-link" %>
    <br>
    <%= button_to "今の記録をやめる", anxiety_log_path(@active_anxiety_log), method: :delete, params: { return_to: "top" }, data: { turbo_confirm: "今の記録を削除しますか？" }, class: "text-link" %>
<% else %>
    <br>
    <%= link_to "他の方法から始める", new_anxiety_log_path(next: "suggestions"), class: "text-link" %>
<% end %>

<br>
<%= link_to "過去の記録を見る", anxiety_logs_path, class: "text-link" %>
<br>
<% if user_signed_in? %>
    <p>ログイン中: <%= current_user.email %></p>
    <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "text-link" %>
<% else %>
    <%= link_to "ログイン", new_user_session_path, class: "text-link" %>
<% end %>
